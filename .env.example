# PostgreSQL
POSTGRES_DB=sfd
POSTGRES_USER=sfd
POSTGRES_PASSWORD=changez-moi
POSTGRES_PORT=5432

# Backend Spring Boot
BACKEND_PORT=8080
# Generer une cle aleatoire d'au moins 64 caracteres avant la production.
JWT_SECRET=remplacez-par-une-cle-aleatoire-de-64-caracteres-minimum-0123456789abcdef

# Frontend nginx
FRONTEND_PORT=8081

# E-mail : Docker Compose utilise Mailpit par defaut.
MAIL_MODE=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_AUTH=false
MAIL_STARTTLS=false
MAIL_FROM=no-reply@sfd.tg
APP_URL=http://localhost:8081
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# Pour un vrai serveur SMTP, remplacer les valeurs ci-dessus avec les
# parametres du fournisseur et un mot de passe d'application renouvele.
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
# MAIL_AUTH=true
# MAIL_STARTTLS=true
